{
  "manifest_version": 3,
  "name": "CyberMatrix link check",
  "version": "0.2.1",
  "description": "Check links with CyberMatrix before you open them. Optional real-time protection warns before a dangerous page loads.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "notifications",
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Check this page with CyberMatrix"
  },
  "options_page": "options.html",
  "icons": {
    "128": "icon.png"
  }
}
