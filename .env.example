# Copy to .env (gitignored) and fill in. Never commit real values.
DATABASE_URL=postgresql+asyncpg://cybermatrix:cybermatrix@localhost:5432/cybermatrix
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GSB_API_KEY=
VT_API_KEY=
URLHAUS_AUTH_KEY=
SEPOLIA_RPC_URL=
RELAYER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
REGISTRY_ADDRESS=0x465094577Fe42BD31d705581bD3baAB51397BbB4
ETHERSCAN_API_KEY=
# Optional
CERTSPOTTER_API_KEY=
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000
# Set to 1 only behind a reverse proxy you control: per-IP rate limiting then uses its X-Forwarded-For
TRUST_FORWARDED_FOR=
MAX_CONCURRENT_ASSESSMENTS=8
# Server-wide cap on new on-chain registrations (each costs relayer gas); per-IP limits don't stop address rotation
REGISTER_MAX_PER_HOUR=30
# Frontend: where the browser reaches the API (docker compose build arg PUBLIC_API_URL)
NEXT_PUBLIC_API_URL=http://localhost:8000
# docker compose overrides DATABASE_URL with the postgres service host; the value above is for running uvicorn locally.
