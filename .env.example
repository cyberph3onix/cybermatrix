# Copy to .env (gitignored) and fill in. Never commit real values.
DATABASE_URL=postgresql+asyncpg://cybermatrix:cybermatrix@localhost:5432/cybermatrix
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# GSB_MODE=hashes (default: only hash prefixes leave the server) | urls (sends full URLs)
GSB_API_KEY=
VT_API_KEY=
URLHAUS_AUTH_KEY=
SEPOLIA_RPC_URL=
RELAYER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
REGISTRY_ADDRESS=0x5De4Cd6F651A4D80ddA16fc70431dd669621BeeA
ETHERSCAN_API_KEY=
# Optional
CERTSPOTTER_API_KEY=
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000
# Set to 1 only behind a reverse proxy you control: per-IP rate limiting then uses its X-Forwarded-For
TRUST_FORWARDED_FOR=
MAX_CONCURRENT_ASSESSMENTS=8
# Server-wide cap on new on-chain registrations (each costs relayer gas); per-IP limits don't stop address rotation
REGISTER_MAX_PER_HOUR=30
# Frontend: where the browser reaches the API (docker compose build arg PUBLIC_API_URL)
NEXT_PUBLIC_API_URL=http://localhost:8000
# docker compose overrides DATABASE_URL with the postgres service host; the value above is for running uvicorn locally.
# Comma-separated Gemini models to try in order on 429/404 (default: gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-flash-lite-latest)
# GEMINI_MODEL=
# docker compose only: chain writes are OFF in the container unless these are set (see docker-compose.yml).
# CHAIN_SEPOLIA_RPC_URL alone enables read-only verification; adding CHAIN_RELAYER_PRIVATE_KEY enables "Register on-chain".
CHAIN_SEPOLIA_RPC_URL=
CHAIN_RELAYER_PRIVATE_KEY=
# docker compose: host port for Postgres, and the API address baked into the frontend build
# POSTGRES_PORT=5432
# PUBLIC_API_URL=http://localhost:8000
# Seconds between registry status re-reads (default 600), CT watch polling interval and watch cap
# REGISTRY_SYNC_S=600
# WATCH_POLL_S=3600
# WATCH_MAX=200
