      "VerificationResult": {
        "additionalProperties": false,
        "properties": {
          "computed_hash": {
            "title": "Computed Hash",
            "type": "string"
          },
          "explorer_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explorer Url"
          },
          "match": {
            "title": "Match",
            "type": "boolean"
          },
          "note": {
            "default": "A matching hash proves this report is unchanged since it was registered. It does not prove the report's conclusions are true.",
            "title": "Note",
            "type": "string"
          },
          "onchain_created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Onchain Created At"
          },
          "onchain_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Onchain Hash"
          },
          "onchain_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RegistryStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "report_id": {
            "title": "Report Id",
            "type": "string"
          },
          "tx_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tx Hash"
          }
        },
        "required": [
          "report_id",
          "computed_hash",
          "onchain_hash",
          "match",
          "onchain_status",
          "onchain_created_at",
          "tx_hash",
          "explorer_url",
          "note"
        ],
        "title": "VerificationResult",
        "type": "object"
      }
    }
  },
