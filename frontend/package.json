{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "gen:openapi": "cd ../backend && uv run python -m app.openapi_export ../frontend/lib/openapi.json",
    "gen:types": "openapi-typescript lib/openapi.json -o lib/api-types.ts",
    "gen": "npm run gen:openapi && npm run gen:types"
  },
  "dependencies": {
    "js-sha3": "^0.13.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
